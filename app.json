{
  "name": "NoMoreHieroglyphics",
  "displayName": "Tech Jargon Translator",
  "description": "Translate terrible tech jargon into plain English",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#ffffff"
  },
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "assetBundlePatterns": [
    "**/*"
  ],
  "ios": {
    "supportsTablet": true,
    "bundleIdentifier": "com.nomohieroglyphics.app",
    "buildNumber": "1.0.0",
    "infoPlist": {
      "NSCameraUsageDescription": "This app does not use the camera",
      "NSPhotoLibraryUsageDescription": "This app does not use the photo library"
    }
  },
  "android": {
    "package": "com.nomohieroglyphics.app",
    "versionCode": 1,
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#FFFFFF"
    },
    "permissions": [
      "INTERNET"
    ]
  }
}
